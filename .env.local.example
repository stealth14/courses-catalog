# Public USDT wallet addresses used by the payment page.
NEXT_PUBLIC_USDT_ERC20=
NEXT_PUBLIC_USDT_BSC=

# Public BTC wallet address used by the Bitcoin payment page.
NEXT_PUBLIC_BTC_WALLET=

# Strapi v5 CMS base URL used by src/utils/api.ts (client-safe, trailing slash optional).
NEXT_PUBLIC_API_URL=

# Strapi v5 API token for authenticated requests (SERVER-ONLY — never rename it with a NEXT_PUBLIC_ prefix).
# Copy this file to .env.local and fill in your real values there.
STRAPI_API_TOKEN=
